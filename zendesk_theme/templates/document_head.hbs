   /* =========================================
   BRANDTRACK — CENTERED LINES (HR + BORDERS)
   Ajustá este ancho a tu layout real
   ========================================= */
:root{
  --bt-content-width: 1240px; /* probá 1200 / 1240 / 1280 */
  --bt-line-color: rgba(255,255,255,.35);
}

/* 1) Si son <hr> reales */
main hr,
hr {
  max-width: var(--bt-content-width) !important;
  width: calc(100% - 48px) !important;  /* padding “virtual” */
  margin-left: auto !important;
  margin-right: auto !important;
  border: 0 !important;
  height: 1px !important;
  background: var(--bt-line-color) !important;
}

/* 2) Si NO son <hr> y vienen de border-top/bottom en secciones */
main > * {
  position: relative;
}

/* mata bordes full-width más comunes */
main .section,
main .section-container,
main .container,
main .community,
main .community-section,
main .home-section,
main .footer,
main [class*="section"] {
  border-top-color: transparent !important;
  border-bottom-color: transparent !important;
}

/* dibuja la línea centrada (arriba) */
main .section::before,
main .section-container::before,
main .container::before,
main .community::before,
main .community-section::before,
main .home-section::before,
main [class*="section"]::before {
  content: "";
  display: none;
  position: absolute;
  top: 0;
  left: 50%;
  width: min(var(--bt-content-width), calc(100% - 48px));
  transform: translateX(-50%);
  height: 1px;
  background: var(--bt-line-color);
  pointer-events: none;
}

/* dibuja la línea centrada (abajo) */
main .section::after,
main .section-container::after,
main .container::after,
main .community::after,
main .community-section::after,
main .home-section::after,
main [class*="section"]::after {
  content: "";
  display: none;
  position: absolute;
  bottom: 0;
  left: 50%;
  width: min(var(--bt-content-width), calc(100% - 48px));
  transform: translateX(-50%);
  height: 1px;
  background: var(--bt-line-color);
  pointer-events: none;
}

/* ACTIVADOR:
   solo muestra las pseudo-líneas en bloques que realmente tengan "Community" o slogan dentro
   (evita que aparezcan por todos lados)
*/
main :is(.community, .community-section, [class*="community"])::before,
main :is(.community, .community-section, [class*="community"])::after {
  display: block;
}
