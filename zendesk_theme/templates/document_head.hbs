   /* ==============================
  /* =========================================================
   HOME – Categories como GRID con líneas (sin “boxes”)
   ========================================================= */

/* 1) Layout: que izquierda (violeta) y derecha (grid) queden alineados y con misma “altura visual” */
.bt-home-layout{
  display: grid;
  grid-template-columns: minmax(420px, 520px) 1fr;
  gap: 56px;
  align-items: stretch;
}

/* Ajustá este alto si querés más/menos aire (pero mantiene ambos paneles “parejos”) */
:root{
  --bt-home-panels-min-h: 560px;
}

.bt-home-left,
.bt-home-right{
  min-height: var(--bt-home-panels-min-h);
}

/* Centrar el grid dentro del panel derecho */
.bt-home-right{
  display: flex;
  align-items: center;     /* centra verticalmente */
  justify-content: center; /* centra horizontalmente */
}

/* 2) Reset de estilos default Zendesk para que no aparezcan “cards” */
.bt-home-right .categories.blocks,
.bt-home-right .blocks-list{
  width: 100%;
}

.bt-home-right .blocks-list{
  list-style: none;
  margin: 0 auto;
  padding: 0;

  /* Grid 3x3 sin gaps (las líneas las hacemos con borders) */
  display: grid;
  grid-template-columns: repeat(3, minmax(180px, 1fr));
  grid-auto-rows: 1fr;
  gap: 0;

  /* control del ancho máximo del grid para que quede como tu mock */
  max-width: 700px;
}

/* Cada item: sin borde, sin fondo, sin radio */
.bt-home-right .blocks-item{
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
}

/* Link como “celda” centrada */
.bt-home-right .blocks-item-link{
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;
  text-decoration: none;

  /* Altura de celda (ajustá si necesitás más aire) */
  min-height: 150px;

  /* Importante: NO boxes */
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;

  padding: 22px 18px;
}

/* 3) Líneas internas del grid (sin borde exterior) */
.bt-home-right .blocks-item:nth-child(1),
.bt-home-right .blocks-item:nth-child(2),
.bt-home-right .blocks-item:nth-child(4),
.bt-home-right .blocks-item:nth-child(5),
.bt-home-right .blocks-item:nth-child(7),
.bt-home-right .blocks-item:nth-child(8){
  border-right: 1px solid rgba(255,255,255,0.18);
}

.bt-home-right .blocks-item:nth-child(1),
.bt-home-right .blocks-item:nth-child(2),
.bt-home-right .blocks-item:nth-child(3),
.bt-home-right .blocks-item:nth-child(4),
.bt-home-right .blocks-item:nth-child(5),
.bt-home-right .blocks-item:nth-child(6){
  border-bottom: 1px solid rgba(255,255,255,0.18);
}

/* 4) Tipos: solo título (sin descripción), en blanco */
.bt-home-right .blocks-item-title{
  display: block;
  color: #fff !important;
  font-weight: 600;
  font-size: 22px;
  line-height: 1.15;
  margin-top: 14px;
}

/* Ocultar descripciones si Zendesk las inyecta */
.bt-home-right .blocks-item-description{
  display: none !important;
}

/* 5) Ícono arriba del texto usando assets (tamaño y separación como tu mock) */
.bt-home-right .blocks-item-link::before{
  content: "";
  display: block;
  width: 48px;
  height: 48px;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  margin-bottom: 6px;

  /* si querés que “floten” más arriba como tu imagen, subí un toque */
  transform: translateY(-4px);
}

/* =========================================================
   MAPPING (por orden 1→9)
   OJO: esto depende del orden de categorías en Zendesk.
   ========================================================= */

/* 1) Digital Signage (NUEVO) */
.bt-home-right .blocks-item:nth-child(1) .blocks-item-link::before{
  background-image: url({{asset 'SIGNAGE.svg'}});
}
/* 2) Primeros pasos */
.bt-home-right .blocks-item:nth-child(2) .blocks-item-link::before{
  background-image: url({{asset 'PRIMEROS-PASOS.svg'}});
}
/* 3) Manejo de cuenta */
.bt-home-right .blocks-item:nth-child(3) .blocks-item-link::before{
  background-image: url({{asset 'CUENTAS.svg'}});
}
/* 4) App */
.bt-home-right .blocks-item:nth-child(4) .blocks-item-link::before{
  background-image: url({{asset 'APP.svg'}});
}
/* 5) Brandtrack Box */
.bt-home-right .blocks-item:nth-child(5) .blocks-item-link::before{
  background-image: url({{asset 'BRANDTRACK-BOX.svg'}});
}
/* 6) Música */
.bt-home-right .blocks-item:nth-child(6) .blocks-item-link::before{
  background-image: url({{asset 'MUSICA.svg'}});
}
/* 7) Anuncios */
.bt-home-right .blocks-item:nth-child(7) .blocks-item-link::before{
  background-image: url({{asset 'anuncios.svg'}});
}
/* 8) Requerimientos técnicos */
.bt-home-right .blocks-item:nth-child(8) .blocks-item-link::before{
  background-image: url({{asset 'TECNICOS.svg'}});
}
/* 9) Método de pago y planes */
.bt-home-right .blocks-item:nth-child(9) .blocks-item-link::before{
  background-image: url({{asset 'PLANS.svg'}});
}
/* 10) Licencias */
.bt-home-right .blocks-item:nth-child(10) .blocks-item-link::before{
  background-image: url({{asset 'LICENCIAS.svg'}});
}

/* 6) Responsive: que baje prolijo en pantallas angostas */
@media (max-width: 1100px){
  .bt-home-layout{
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .bt-home-right{
    justify-content: flex-start;
  }
  .bt-home-right .blocks-list{
    max-width: 760px;
  }
}

@media (max-width: 820px){
  .bt-home-right .blocks-list{
    grid-template-columns: repeat(2, minmax(160px, 1fr));
  }

  /* re-armar líneas internas para 2 columnas */
  .bt-home-right .blocks-item{
    border-right: none;
    border-bottom: none;
  }
  .bt-home-right .blocks-item:nth-child(odd){
    border-right: 1px solid rgba(255,255,255,0.18);
  }
  .bt-home-right .blocks-item:nth-child(-n+8){
    border-bottom: 1px solid rgba(255,255,255,0.18);
  }
}

@media (max-width: 520px){
  .bt-home-right .blocks-list{
    grid-template-columns: 1fr;
  }

  /* líneas internas en 1 columna = solo horizontales */
  .bt-home-right .blocks-item{
    border-right: none !important;
    border-bottom: 1px solid rgba(255,255,255,0.18);
  }
  .bt-home-right .blocks-item:last-child{
    border-bottom: none;
  }
}
   /* =============================
   AJUSTE 1: subir el grid (alinear con el panel violeta)
   ============================= */

/* En vez de centrar verticalmente, alineamos arriba */
.bt-home-right{
  align-items: flex-start !important;  /* antes estaba center */
  padding-top: 0 !important;
}

/* Control fino: sube el grid completo X px */
.bt-home-right .categories.blocks{
  margin-top: 34px !important;  /* subí/bajá este valor (ej: 28–48) */
}

/* =============================
   AJUSTE 2: textos largos en 2 líneas (sin cortar)
   ============================= */

/* Que el título pueda wrappear y no quede recortado */
.bt-home-right .blocks-item-title{
  max-width: 210px;            /* ancho del bloque de texto dentro de cada celda */
  white-space: normal !important;
  word-break: normal !important;
  overflow-wrap: anywhere;
  text-align: center;
}

/* Solo para 7 y 8: forzar 2 líneas con ancho más chico */
.bt-home-right .blocks-item:nth-child(7) .blocks-item-title,
.bt-home-right .blocks-item:nth-child(8) .blocks-item-title{
  max-width: 175px;            /* fuerza el salto de línea */
}

/* Extra: bajar un toque el tamaño si sigue “apretado” */
.bt-home-right .blocks-item:nth-child(7) .blocks-item-title,
.bt-home-right .blocks-item:nth-child(8) .blocks-item-title{
  font-size: 20px !important;
  line-height: 1.15 !important;
}
   /* SUBIR UN PELÍN MÁS EL GRID */
.bt-home-right .categories.blocks{
  margin-top: 0px !important; /* antes 34px: probá 20px / 16px / 12px */
}
/* SOLO la última card (Licencias) */
.bt-home-right .blocks-list > .blocks-item:nth-child(9) .blocks-item-link{
  /* mantené lo mismo que las otras */
  border-radius: 18px !important;

  /* sacamos cualquier borde anterior */
  border: 1px solid transparent !important;

  /* esto dibuja:
     - capa 1: "relleno" negro (igual al fondo) dentro del padding-box
     - capa 2: borde con gradiente (izq más transparente -> der normal) en el border-box */
  background:
    linear-gradient(#000,#000) padding-box,
    linear-gradient(
      90deg,
      rgba(255,255,255,0.06) 0%,
      rgba(255,255,255,0.10) 35%,
      rgba(255,255,255,0.18) 100%
    ) border-box !important;

  /* por las dudas, que no meta sombras raras */
  box-shadow: none !important;
}
 /* =========================
   1) Achicar espacio negro
   ========================= */
.section.home-section.community,
.section.home-section.activity,
.recent-activity,
.recent-activity-section {
  display: none !important;
  margin: 0 !important;
  padding: 0 !important;
  height: 0 !important;
}

main#main-content,
.bt-home-right,
.section.knowledge-base,
.categories.blocks,
.blocks-list {
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
}

/* Reduce el aire general debajo del grid en home */
.bt-home,
.bt-home-layout,
.container.bt-home {
  padding-bottom: 24px !important; /* ajustá 16/24/32 si querés */
  margin-bottom: 0 !important;
}

/* =========================
   2) Mantener footer, pero sacar "Brandtrack 3.0" + líneas
   ========================= */

/* NO ocultamos el footer completo */
footer,
.footer,
.site-footer {
  display: block !important;
}

/* Sacar la línea gruesa de arriba del footer (y cualquier border-top típico) */
footer,
.footer,
.site-footer {
  border-top: none !important;
}

/* Sacar “líneas finitas” internas (pseudo-elementos comunes) */
footer::before,
footer::after,
.footer::before,
.footer::after,
.site-footer::before,
.site-footer::after {
  content: none !important;
  display: none !important;
  border: 0 !important;
}

/* Ocultar el rótulo "Brandtrack 3.0" (suele estar como texto/link dentro del footer) */
footer a,
footer p,
footer span {
  /* no tocamos todo, solo el que coincida con el texto exacto */
}

footer a[href*="brandtrack"],
footer a[href*="Brandtrack"] {
  /* dejamos links normales; no hacemos nada */
}

/* Oculta específicamente el elemento que contiene "Brandtrack 3.0" */
footer *:has(> :is(a,span,p):contains("Brandtrack 3.0")),
footer *:contains("Brandtrack 3.0") {
  display: none !important;
}

/* Si tu navegador/Zendesk no soporta :contains/:has, usá la alternativa de abajo */  
/* =========================
   REMOVE "Brandtrack 3.0" STRIP + LINES (keep big footer)
   ========================= */

/* 1) Hide the small top strip that contains "Brandtrack 3.0" */
.footer .footer-nav,
.footer .footer-inner > .footer-nav,
.footer .footer-top,
.footer .footer-upper,
.footer .footer-heading,
.footer .footer-title {
  display: none !important;
}

/* 2) Remove the horizontal rules / border lines in footer area */
.footer hr,
.footer .footer-line,
.footer .footer-divider,
.footer::before,
.footer::after,
.footer *::before,
.footer *::after {
  /* (only affects footer-generated lines) */
  border-top: 0 !important;
  border-bottom: 0 !important;
  box-shadow: none !important;
}

/* 3) Tighten spacing so there isn't a "dead" band above the big logo */
.footer {
  padding-top: 0 !important;
  margin-top: 0 !important;
}

/* 4) If Zendesk is adding a wrapper strip above the footer */
.footer + .footer,
.footer .container {
  border-top: 0 !important;
}
   /* Hide only the "Brandtrack 3.0" text in the footer strip (keep the line) */
.footer .footer-nav,
.footer .footer-upper,
.footer .footer-top,
.footer .footer-heading,
.footer .footer-title {
  display: none !important;
}

/* If your theme uses a plain paragraph/span for that label, hide it too */
.footer p,
.footer span {
  /* no afecta al logo grande porque suele ser background/svg, no texto */
}
   /* =========================================================
   NUCLEAR: Instant search dropdown (Zendesk) - force dark UI
   Pegalo al FINAL de style.css
   ========================================================= */

:root{
  --bt-dd-bg: #0b0b0f;
  --bt-dd-bg2:#141420;
  --bt-dd-border: rgba(255,255,255,.14);
  --bt-dd-text: rgba(255,255,255,.92);
  --bt-dd-muted: rgba(255,255,255,.62);
  --bt-dd-violet:#7455FD;
}

/* Caza cualquier dropdown típico por class parcial o roles */
html body [class*="searchbox-suggest"],
html body [class*="searchboxSuggest"],
html body [class*="instant-search"],
html body [class*="instantSearch"],
html body [class*="search-results"],
html body [class*="searchResults"],
html body [class*="autocomplete"],
html body [class*="auto-complete"],
html body [class*="suggestion"],
html body [class*="suggestions"],
html body [role="listbox"],
html body [role="option"][aria-selected],
html body [data-search-results],
html body [data-suggestions]{
  background: var(--bt-dd-bg) !important;
  border: 1px solid var(--bt-dd-border) !important;
  border-radius: 16px !important;
  box-shadow: 0 18px 50px rgba(0,0,0,.55) !important;
  color: var(--bt-dd-text) !important;
}

/* Fuerza colores adentro del dropdown */
html body [class*="searchbox-suggest"] *,
html body [class*="instant-search"] *,
html body [class*="search-results"] *,
html body [class*="autocomplete"] *,
html body [class*="suggestions"] *,
html body [data-search-results] *{
  color: var(--bt-dd-text) !important;
}

/* Items / hover */
html body [class*="searchbox-suggest"] li,
html body [class*="instant-search"] li,
html body [class*="search-results"] li,
html body [class*="autocomplete"] li,
html body [class*="suggestion"],
html body [role="option"]{
  background: transparent !important;
  border-top: 1px solid var(--bt-dd-border) !important;
}

html body [class*="searchbox-suggest"] li:hover,
html body [class*="instant-search"] li:hover,
html body [class*="search-results"] li:hover,
html body [class*="autocomplete"] li:hover,
html body [class*="suggestion"]:hover,
html body [role="option"]:hover,
html body [aria-selected="true"]{
  background: var(--bt-dd-bg2) !important;
}

/* Links violeta */
html body [class*="searchbox-suggest"] a,
html body [class*="instant-search"] a,
html body [class*="search-results"] a,
html body [class*="autocomplete"] a,
html body [class*="suggestion"] a{
  color: var(--bt-dd-violet) !important;
  text-decoration: none !important;
}

/* Texto secundario / breadcrumb gris */
html body [class*="breadcrumb"],
html body [class*="meta"],
html body [class*="description"],
html body [class*="subtext"],
html body [class*="secondary"]{
  color: var(--bt-dd-muted) !important;
}

/* Oculta la línea tipo "Brandtrack 3.0 > ..." dentro del dropdown */
html body [class*="breadcrumb"],
html body [class*="BreadCrumb"],
html body [class*="search-result-breadcrumb"],
html body [class*="searchResultBreadcrumb"],
html body [class*="search-result-meta"],
html body [class*="searchResultMeta"]{
  display: none !important;
}

/* Highlight de término buscado */
html body [class*="searchbox-suggest"] mark,
html body [class*="instant-search"] mark,
html body [class*="search-results"] mark,
html body [class*="autocomplete"] mark,
html body [class*="searchbox-suggest"] strong,
html body [class*="instant-search"] strong,
html body [class*="search-results"] strong{
  color: var(--bt-dd-violet) !important;
  background: transparent !important;
  font-weight: 700 !important;
}
   /* =========================
   BRANDTRACK – SEARCH PAGE
   ========================= */

/* Fondo general */
body[class*="search"] main,
body[class*="search"] .container,
body[class*="search"] .container-divider,
body[class*="search"] .search-results {
  background: #000 !important;
}

/* Ocultar sidebar de filtros (Tipo/Artículos) */
.search-results-sidebar,
.search-results-column + .search-results-sidebar,
.search-results .search-results-sidebar {
  display: none !important;
}

/* Hacer que la columna de resultados ocupe todo */
.search-results-column,
.search-results .search-results-column {
  width: 100% !important;
  max-width: 980px;
  margin: 0 auto !important;
  padding: 28px 18px 60px !important;
}

/* Header “X resultados para…” */
.search-results-column h1,
.search-results-column h2,
.search-results-column .search-results-subheading {
  color: #fff !important;
}

/* Lista de resultados: tarjetas */
.search-results-list,
.search-results-column ul {
  list-style: none !important;
  padding: 0 !important;
  margin: 16px 0 0 !important;
}

.search-result,
.search-results-list li {
  background: rgba(255,255,255,0.04) !important;
  border: 1px solid rgba(255,255,255,0.10) !important;
  border-radius: 16px !important;
  padding: 16px 18px !important;
  margin: 12px 0 !important;
}

/* Título del resultado */
.search-result a,
.search-result-title a,
.search-results-list a {
  color: #7455FD !important; /* violeta Brandtrack */
  text-decoration: none !important;
  font-weight: 700 !important;
}

.search-result a:hover,
.search-result-title a:hover,
.search-results-list a:hover {
  text-decoration: underline !important;
}

/* Snippet / descripción */
.search-result-description,
.search-result-snippet,
.search-result-meta,
.search-results-list p,
.search-results-list span {
  color: rgba(255,255,255,0.78) !important;
}

/* Breadcrumb del resultado (Brandtrack 3.0 > …) */
.search-result-breadcrumbs,
.search-result-breadcrumbs a {
  color: rgba(255,255,255,0.45) !important;
  text-decoration: none !important;
}

/* Input search de esa página (arriba) */
.search-results input[type="search"],
.search-results input[type="text"],
.search-results .search input {
  background: rgba(255,255,255,0.08) !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,0.14) !important;
  border-radius: 999px !important;
}

.search-results input::placeholder {
  color: rgba(255,255,255,0.55) !important;
}
   /* =========================
   SEARCH: SOLO TEXTO (sin cards/box)
   ========================= */

/* Quitar cualquier “card”/contenedor grande */
.search-results-column,
.search-results .search-results-column,
.search-results,
.search-results .search-results-list,
.search-results-list,
.search-result,
.search-results-list li,
.search-result-content,
.search-result-content-container,
.search-results-column .panel,
.search-results-column [class*="card"],
.search-results-column [class*="box"] {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
  border-radius: 0 !important;
}

/* Separación simple entre resultados */
.search-results-list li,
.search-result {
  padding: 14px 0 !important;
  margin: 0 !important;
  border-bottom: 1px solid rgba(255,255,255,0.10) !important;
}

.search-results-list li:last-child,
.search-result:last-child {
  border-bottom: 0 !important;
}

/* Títulos violeta */
.search-result-title a,
.search-results-list a,
.search-result a {
  color: #7455FD !important;
  font-weight: 700 !important;
  text-decoration: none !important;
}

.search-result-title a:hover,
.search-results-list a:hover {
  text-decoration: underline !important;
}

/* Snippet / texto: blanco */
.search-result-description,
.search-result-snippet,
.search-results-list p,
.search-results-list span {
  color: rgba(255,255,255,0.85) !important;
}

/* Breadcrumb: más suave */
.search-result-breadcrumbs,
.search-result-breadcrumbs a {
  color: rgba(255,255,255,0.45) !important;
}

/* (Opcional) si querés sacar breadcrumbs directamente */
 /* .search-result-breadcrumbs { display:none !important; } */
   
   /* =========================================================
   KILL BOX: "XX resultados para ..." (wrapper + pseudo elems)
   ========================================================= */

/* 1) Zona del header del listado (título/counter) */
.search-results .search-results-column header,
.search-results .search-results-column header *,
.search-results .search-results-heading,
.search-results .search-results-heading *,
.search-results .search-results-count,
.search-results .search-results-subheading,
.search-results .search-results-title {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
  outline: 0 !important;
  border-radius: 0 !important;
  backdrop-filter: none !important;
